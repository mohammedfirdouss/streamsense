# Gemini API key (https://aistudio.google.com/apikey). Without it the app runs in demo mode
# with clearly marked sample AI answers.
GEMINI_API_KEY=

# Optional. Which Gemini model to use. Defaults to gemini-flash-latest.
GEMINI_MODEL=

# Set to 1 to force demo mode even when a key is present.
STREAMSENSE_DEMO=
